PORT=3000
DATABASE_PATH=./falsequote.sqlite
# Use your deployed site URL, or leave blank when you only use /app on this server.
CORS_ORIGIN=https://your-domain.com

# Required to accept Razorpay payments. Use rzp_test_* keys while testing.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_secret_after_registration

# Optional but recommended: create a Razorpay payment.captured webhook for /api/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Used to sign into the protected admin dashboard. Set either one; ADMIN_PASSWORD is best for browser login.
ADMIN_PASSWORD=replace-with-your-dashboard-password
ADMIN_API_KEY=replace-with-a-long-random-admin-key
